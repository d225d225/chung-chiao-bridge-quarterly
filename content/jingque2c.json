[
 {
  "type": "para",
  "text": "精確2C後續系統性改進"
 },
 {
  "type": "para",
  "text": "一、漏洞分析"
 },
 {
  "type": "para",
  "text": "精確2C是後續空間相當緊缺的一個開叫，因此設計者建議儘量為其減負——5422型牌最好開叫1NT；而對於D4C5甚至D4C6的牌，先開1D通常也是利大於弊。然而，即便你盡了全力為精確2C做出了減負，常規的後續叫牌仍有一些漏洞。"
 },
 {
  "type": "para",
  "text": "我們先來看第一個漏洞：聯手5-1以下3C的問題。"
 },
 {
  "type": "para",
  "text": "通常情況下："
 },
 {
  "type": "para",
  "text": "2C—2D—？"
 },
 {
  "type": "para",
  "text": "2M：M4"
 },
 {
  "type": "para",
  "text": "2NT：接力問高低限和牌型"
 },
 {
  "type": "para",
  "text": "2NT以上：各種各樣C6+，無M4的牌"
 },
 {
  "type": "para",
  "text": "這種叫法有這樣一個問題：開方C5M4對著同伴C0-1怎麼辦？比如4135對著3451、3415對著4351……這樣的例子其實不少。"
 },
 {
  "type": "para",
  "text": "雖然2NT通常不是什麼好定約，但是比6張配的3C還是好多了——況且2C開叫之後方塊這門花色往往是被忽視的，你並沒有手段找到潛在的方塊配，由此可見2NT理當成為一個“雖不完美，勉強能用”的落腳點。"
 },
 {
  "type": "para",
  "text": "接下來再看第二個漏洞：應叫方2M模糊C配情況的問題。"
 },
 {
  "type": "para",
  "text": "我們知道2C-2M表示M5+，通常是邀請實力，NF，這時開方往往不知道梅花配合情況。"
 },
 {
  "type": "para",
  "text": "如果應方是3631這種梅花失配牌，打2H通常是對的。"
 },
 {
  "type": "para",
  "text": "如果應方是3514這種梅花好配牌，那麼2H沒有叫滿實力，3C更是不用考慮，3H則是沒有回頭路了（同伴失配時3H打宕但3C易成）；若採用2D問叫，又難以找到H53配合。"
 },
 {
  "type": "para",
  "text": "二、方法論述"
 },
 {
  "type": "para",
  "text": "為了填補這兩個漏洞，我開發了以下辦法，包含以下3個要點："
 },
 {
  "type": "para",
  "text": "1、應方邀請實力C有配的M5持牌放在2D問叫中，後續能在3C以下探討所有M53與M44配合，且通常能夠區分同伴C5/C6配合強度；"
 },
 {
  "type": "para",
  "text": "2、應方C不配的M5+持牌放在2M應叫，一口提醒同伴失配早停；"
 },
 {
  "type": "para",
  "text": "3、應方2D問叫後，對於所有潛在的梅花5-0/5-1配都配備了預警裝置，有機會停在2NT或3D。"
 },
 {
  "type": "para",
  "text": "具體做法如下，主叫品標紅，賓叫品標黑。"
 },
 {
  "type": "para",
  "text": "2C—？"
 },
 {
  "type": "para",
  "text": "2D：邀請實力以上，垃圾桶，不符其他叫品的任意牌型"
 },
 {
  "type": "para",
  "text": "2H：H3+，排除高限H3+S4（叫3H），排除高限H4D3（叫3NT）"
 },
 {
  "type": "para",
  "text": "2S：GF任意無S5，或邀請實力H4+（含H4S4型）"
 },
 {
  "type": "para",
  "text": "2NT：低限，H3S4，NF，同伴S3-H4-D5+C1-可以放掉"
 },
 {
  "type": "para",
  "text": "3C：低限，H3S3-，可推導出C6+，NF"
 },
 {
  "type": "para",
  "text": "3D：H4D0-1"
 },
 {
  "type": "para",
  "text": "3H：H4無進局意願，同伴低限不叫，高限加到4H"
 },
 {
  "type": "para",
  "text": "3S：問高低限，高限可越過3NT"
 },
 {
  "type": "para",
  "text": "3NT/4H：要打"
 },
 {
  "type": "para",
  "text": "3H：低限，H4S0-1"
 },
 {
  "type": "para",
  "text": "3S：高限，H4S0-1"
 },
 {
  "type": "para",
  "text": "3NT：高限，H3S3-，暗含C6+"
 },
 {
  "type": "para",
  "text": "2NT：邀請實力，H3-S4，通常C2+（否則直接應2NT），F到3C"
 },
 {
  "type": "para",
  "text": "3C：邀請實力，要打"
 },
 {
  "type": "para",
  "text": "3D：GF，S5+"
 },
 {
  "type": "para",
  "text": "3H：H4，同伴用3S顯示S6"
 },
 {
  "type": "para",
  "text": "3S：H3，S2+"
 },
 {
  "type": "para",
  "text": "3NT：H3，S0-1"
 },
 {
  "type": "para",
  "text": "3H：邀請實力，H5"
 },
 {
  "type": "para",
  "text": "2S：H2-S3+，排除高限D3S4（叫3S），排除低限4135（叫2NT）"
 },
 {
  "type": "para",
  "text": "容易推得低限時必有C6"
 },
 {
  "type": "para",
  "text": "2NT：GF任意，或S4邀請實力"
 },
 {
  "type": "para",
  "text": "3C：低限，S3"
 },
 {
  "type": "para",
  "text": "3D：高限任意"
 },
 {
  "type": "para",
  "text": "3H：重詢H2和S4，保證持有H6"
 },
 {
  "type": "para",
  "text": "3S：H1-，S4"
 },
 {
  "type": "para",
  "text": "3NT：H1-，S3"
 },
 {
  "type": "para",
  "text": "4V：H2，已定H將，自報關鍵張"
 },
 {
  "type": "para",
  "text": "3S：重詢S4"
 },
 {
  "type": "para",
  "text": "3H：低限，S4H0-1"
 },
 {
  "type": "para",
  "text": "3S：低限，S4D0-1"
 },
 {
  "type": "para",
  "text": "3C：邀請實力，NF"
 },
 {
  "type": "para",
  "text": "3S：邀請實力，S5"
 },
 {
  "type": "para",
  "text": "2NT：4135，低限，NF"
 },
 {
  "type": "para",
  "text": "3C：M2-，C6+單套，低限"
 },
 {
  "type": "para",
  "text": "3D：M2-，C6+單套，高限"
 },
 {
  "type": "para",
  "text": "3H：H3+S4，高限，同伴3S重詢H4"
 },
 {
  "type": "para",
  "text": "3S：D3S4，高限"
 },
 {
  "type": "para",
  "text": "3NT：D3H4，高限"
 },
 {
  "type": "para",
  "text": "2M：M5+，通常C失配，NF"
 },
 {
  "type": "para",
  "text": "2NT：S4H3-D5+C0-1邀請實力，NF，同伴可以改到3C、3D止叫"
 },
 {
  "type": "para",
  "text": "這種牌一旦先用2D問叫，同伴H3+S3-時會出事，故預先分離"
 },
 {
  "type": "para",
  "text": "3C：C3+，阻擊叫"
 },
 {
  "type": "para",
  "text": "3D：D7+，C極短，修正定約，NF"
 },
 {
  "type": "para",
  "text": "三、結論"
 },
 {
  "type": "para",
  "text": "該裝置解決了以下幾個問題："
 },
 {
  "type": "para",
  "text": "1、規避了5-0/5-1配的3C，可以打2NT，還可以在方塊配合時打3D；"
 },
 {
  "type": "para",
  "text": "2、應方M5+邀請實力牌是否有C配得以區分；"
 },
 {
  "type": "para",
  "text": "3、尋找M5-3配可以在2階進行，非常便利；設想在傳統叫法中應方持MM54邀請實力，若用2D問叫期待同伴出M4而他沒有叫2M，後面就彈盡糧絕，沒有辦法在3C以下找到M5-3配了；"
 },
 {
  "type": "para",
  "text": "4、考慮到開方持M4時必有單缺（這是因為C5M422算作均型進入無將階梯）現在開方作出M4加叫時通常可以在3M之下一併顯示單缺，提高了邀局的精細度。"
 }
]